{
  "name": "filepilot",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",

    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",

    "db:migrate": "pnpm --filter @filepilot/db db:migrate",
    "db:studio": "pnpm --filter @filepilot/db db:studio",
    "db:seed": "pnpm --filter @filepilot/db db:seed"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.13",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
